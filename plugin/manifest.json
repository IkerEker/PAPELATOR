{
  "manifestVersion": 5,
  "id": "com.papelator.paper",
  "name": "PAPELATOR",
  "version": "2.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.2.0"
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "papelator",
      "label": {
        "default": "PAPELATOR",
        "es_ES": "PAPELATOR"
      },
      "minimumSize": {
        "width": 250,
        "height": 420
      },
      "maximumSize": {
        "width": 600,
        "height": 3000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 800
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ],
          "species": [
            "chrome"
          ]
        }
      ]
    },
    {
      "type": "panel",
      "id": "papelatorAjustes",
      "label": {
        "default": "PAPELATOR · Ajustes",
        "es_ES": "PAPELATOR · Ajustes"
      },
      "minimumSize": {
        "width": 260,
        "height": 420
      },
      "maximumSize": {
        "width": 700,
        "height": 3000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 820
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 860
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel2.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ],
          "species": [
            "chrome"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}