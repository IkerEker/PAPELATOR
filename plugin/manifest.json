{
  "manifestVersion": 5,
  "id": "com.ikereker.papelator",
  "name": "PAPELATOR",
  "version": "3.8.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "requiredPermissions": {
    "localFileSystem": "plugin"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "papelator",
      "label": {
        "default": "PAPELATOR"
      },
      "minimumSize": {
        "width": 260,
        "height": 420
      },
      "maximumSize": {
        "width": 600,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 310,
        "height": 800
      },
      "preferredFloatingSize": {
        "width": 330,
        "height": 840
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}