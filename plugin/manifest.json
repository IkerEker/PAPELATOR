{
  "manifestVersion": 5,
  "id": "com.ikereker.papelator",
  "name": "PAPELATOR",
  "version": "2.0.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "requiredPermissions": {
    "localFileSystem": "plugin"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "papelator",
      "label": { "default": "PAPELATOR" },
      "minimumSize": { "width": 250, "height": 420 },
      "maximumSize": { "width": 600, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 760 },
      "preferredFloatingSize": { "width": 320, "height": 800 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"] }
      ]
    },
    {
      "type": "panel",
      "id": "papelatorAjustes",
      "label": { "default": "PAPELATOR · Ajustes" },
      "minimumSize": { "width": 260, "height": 420 },
      "maximumSize": { "width": 700, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 820 },
      "preferredFloatingSize": { "width": 340, "height": 860 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel2.png", "scale": [1, 2], "theme": ["all"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
